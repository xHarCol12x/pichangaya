generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String               @id @default(uuid())
  email                     String               @unique
  password                  String
  name                      String?
  role                      Role                 @default(USER)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  isActive                  Boolean              @default(true)
  plan                      String               @default("FREE_TRIAL")
  subscriptionEndsAt        DateTime?
  mercadopagoCustomerId     String?              @unique
  mercadopagoSubscriptionId String?              @unique
  themePreference           String               @default("system")
  emailNotifications        Boolean              @default(true)
  featureOverrides          Json?                @default("{}")
  bookings                  Booking[]
  passwordResetTokens       PasswordResetToken[]
  payments                  Payment[]            @relation("UserPayments")
  pushSubscriptions         PushSubscription[]
  sessions                  Session[]
  subscriptions             Subscription[]       @relation("UserSubscriptions")
  tenantInvoices            TenantInvoice[]
  memberships               TenantMembership[]
}

model Tenant {
  id                 String             @id @default(uuid())
  name               String
  isActive           Boolean            @default(true)
  plan               String             @default("FREE_TRIAL")
  subscriptionEndsAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  members            TenantMembership[]
  venues             Venue[]
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  planCode  String
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String
  createdAt DateTime  @default(now())
  user      User      @relation("UserSubscriptions", fields: [userId], references: [id])

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Venue {
  id          String    @id @default(uuid())
  name        String
  address     String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenantId    String
  clients     Client[]
  fields      Field[]
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Field {
  id           String    @id @default(uuid())
  name         String
  type         String
  surface      String?
  pricePerHour Float
  venueId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  bookings     Booking[]
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  notes     String?
  venueId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  bookings  Booking[]
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([phone])
}

model Booking {
  id            String    @id @default(uuid())
  startTime     DateTime
  endTime       DateTime
  totalPrice    Float
  status        String
  paymentMethod String?
  userId        String
  fieldId       String
  clientId      String?
  paymentId     String?   @unique
  reminderSent  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  client        Client?   @relation(fields: [clientId], references: [id])
  field         Field     @relation(fields: [fieldId], references: [id])
  payment       Payment?  @relation(fields: [paymentId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([fieldId, startTime, endTime])
  @@index([userId])
  @@index([status])
}

model Payment {
  id            String   @id @default(uuid())
  amount        Float
  status        String
  transactionId String?
  createdAt     DateTime @default(now())
  planCode      String?
  userId        String?
  booking       Booking?
  user          User?    @relation("UserPayments", fields: [userId], references: [id])
}

model ProcessedWebhook {
  id        String   @id @default(uuid())
  webhookId String   @unique
  source    String
  type      String?
  payload   Json?
  createdAt DateTime @default(now())
}

model AnalyticsLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityId   String
  entityType String
  userId     String?
  details    Json?
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  priceMensual      Float
  priceAnual        Float
  limitVenues       Int      @default(1)
  limitFields       Int
  isActive          Boolean  @default(true)
  isPopular         Boolean  @default(false)
  mercadopagoPlanId String?
  features          String[] @default([])
  icon              String   @default("Star")
  accent            String   @default("#38bdf8")
  accentLight       String   @default("#7dd3fc")
  permissions       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TenantInvoice {
  id        String   @id @default(uuid())
  amount    Float
  currency  String   @default("PEN")
  status    String   @default("PAID")
  userId    String
  planCode  String?
  paymentId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  USER
  SUPER_ADMIN
}
