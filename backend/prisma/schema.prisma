generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String               @id @default(uuid())
  email                     String               @unique
  password                  String
  name                      String?
  role                      Role                 @default(USER)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  isActive                  Boolean              @default(true)
  plan                      String               @default("FREE_TRIAL")
  subscriptionEndsAt        DateTime?
  mercadopagoCustomerId     String?              @unique
  mercadopagoSubscriptionId String?              @unique
  themePreference           String               @default("system")
  emailNotifications        Boolean              @default(true)
  featureOverrides          Json?                @default("{}")
  bookings                  Booking[]
  venues                    Venue[]
  passwordResetTokens       PasswordResetToken[]
  tenantInvoices            TenantInvoice[]
  pushSubscriptions         PushSubscription[]
}

model Venue {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fields      Field[]
  clients     Client[]
  owner       User     @relation(fields: [ownerId], references: [id])
}

model Field {
  id           String    @id @default(uuid())
  name         String
  type         String
  surface      String?
  pricePerHour Float
  venueId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  venue        Venue     @relation(fields: [venueId], references: [id])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  notes     String?
  venueId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  venue     Venue     @relation(fields: [venueId], references: [id])
  bookings  Booking[]
}

model Booking {
  id            String   @id @default(uuid())
  startTime     DateTime
  endTime       DateTime
  totalPrice    Float
  status        String
  paymentMethod String?
  userId        String
  fieldId       String
  clientId      String?
  paymentId     String?  @unique
  reminderSent  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client?  @relation(fields: [clientId], references: [id])
  field         Field    @relation(fields: [fieldId], references: [id])
  payment       Payment? @relation(fields: [paymentId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  amount        Float
  status        String
  transactionId String?
  createdAt     DateTime @default(now())
  booking       Booking?
}

model AnalyticsLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g., "PLAN_UPDATED", "CLIENT_CREATED", "VENUE_ACTIVATED"
  entityId  String   // e.g., the ID of the plan, client, or venue
  entityType String  // e.g., "SubscriptionPlan", "Client", "Venue"
  userId    String?  // The user who performed the action (can be null if system)
  details   Json?    // Optional details about what changed (old logic vs new logic)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  USER
  SUPER_ADMIN
}

model SubscriptionPlan {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  priceMensual      Float
  priceAnual        Float
  limitVenues       Int      @default(1)
  limitFields       Int
  isActive          Boolean  @default(true)
  isPopular         Boolean  @default(false)
  stripePriceId     String?
  mercadopagoPlanId String?
  features          String[] @default([])
  icon              String   @default("Star")
  accent            String   @default("#38bdf8")
  accentLight       String   @default("#7dd3fc")
  permissions       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TenantInvoice {
  id        String   @id @default(uuid())
  amount    Float
  currency  String   @default("PEN")
  status    String   @default("PAID")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  planCode  String?
  paymentId String? // Ex: Mercadopago ID
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
